# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#1a1a1a"

# Main text color
theme[main_fg]="#696969"

# Title color for boxes
theme[title]="#696969"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#808080"

# Background color of selected item in processes box. #313131 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #313131 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#313131"

# Foreground color of selected item in processes box. Use #696969 so
# the row text stays readable on the lighter_bg highlight; the previous
# #808080 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#696969"

# Color of inactive/disabled text
theme[inactive_fg]="#434343"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #808080 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #696969 directly.
theme[graph_text]="#696969"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #313131 collapsed to the main fg.
theme[meter_bg]="#313131"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #dadada for a distinct accent instead of #808080 which capped to white.
theme[proc_misc]="#dadada"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#acacac"
theme[mem_box]="#00c800"
theme[net_box]="#ff0000"
theme[proc_box]="#808080"

# Box divider line and small boxes line color
theme[div_line]="#434343"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#00c800"
theme[temp_mid]="#ffb800"
theme[temp_end]="#ff0000"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#dadada"
theme[cpu_mid]="#0e00de"
theme[cpu_end]="#acacac"

# Mem/Disk free meter
theme[free_start]="#acacac"
theme[free_mid]="#0e00de"
theme[free_end]="#dadada"

# Mem/Disk cached meter
theme[cached_start]="#0e00de"
theme[cached_mid]="#dadada"
theme[cached_end]="#acacac"

# Mem/Disk available meter
theme[available_start]="#ffb800"
theme[available_mid]="#ff0000"
theme[available_end]="#ff0000"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#00c800"
theme[used_mid]="#dadada"
theme[used_end]="#0e00de"

# Download graph colors
theme[download_start]="#ffb800"
theme[download_mid]="#ff0000"
theme[download_end]="#ff0000"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#00c800"
theme[upload_mid]="#dadada"
theme[upload_end]="#0e00de"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#dadada"
theme[process_mid]="#0e00de"
theme[process_end]="#acacac"
